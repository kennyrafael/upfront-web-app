# Backend origin the dev server proxies /api to.
VITE_API_URL=http://localhost:3100

# Stripe's publishable key, from the same account as the API's secret key. Safe in the
# bundle: it identifies the account and authorises nothing — every amount is decided server
# side. Without it the app still runs; it simply cannot take a payment.
# VITE_STRIPE_PUBLIC_KEY=pk_test_...
